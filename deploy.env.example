#
# Copy to deploy.env (git-ignored) and customize. Define multiple sites in this
# one file by numbering the vars. Deploy to a specific site with:
#   SITE=site1 make deploy-dataplane-vip
#   SITE=site2 make deploy-dataplane-vip
#
# All deploy commands are idempotent (safe to run multiple times):
#   make deploy-dataplane-vip         # Re-run anytime, only changes what's needed
#   SITES="site1 site2" make deploy-all-sites  # Deploy/update all sites at once
#
# For a single site, just set SITE and the numbered vars; for multiple sites,
# add more numbered sections.

# Active site to deploy to (single-site deployment)
SITE=site1

# Set METALLB_MODE=dpf when DPF/HCP already provides MetalLB in
# openshift-operators. Leave unset (standalone) for a NICo-only cluster.
# METALLB_MODE=standalone

# Deploy to all sites at once with 'make deploy-all-sites'
# Uncomment to deploy multiple sites: SITES="site1 site2 site3"
SITES=

# ============================================================================
# Site: site1 — Lab/US East
# ============================================================================
DATAPLANE_VIP_SITE1=10.0.0.100         # shared VIP for all services
DATAPLANE_POOL_SITE1=10.0.0.100-10.0.0.110  # MetalLB pool/range (one free IP per service)
DATAPLANE_NIC_SITE1=ens1f0             # node NIC on the data-plane VLAN
DATAPLANE_NODE_IP_SITE1=10.0.0.2       # static IP for node's dataplane NIC (free IP on VLAN)

# ============================================================================
# Site: site2 — Lab/US West (working example)
# ============================================================================
DATAPLANE_VIP_SITE2=10.6.145.100       # shared VIP for all services
DATAPLANE_POOL_SITE2=10.6.145.100-10.6.145.110  # MetalLB pool/range
DATAPLANE_NIC_SITE2=ens1f0             # node NIC on the data-plane VLAN
DATAPLANE_NODE_IP_SITE2=10.6.145.2     # static IP for node's dataplane NIC

# ============================================================================
# Site: site3 — Lab/EU (working example)
# ============================================================================
DATAPLANE_VIP_SITE3=10.20.30.100       # shared VIP for all services
DATAPLANE_POOL_SITE3=10.20.30.100-10.20.30.110  # MetalLB pool/range
DATAPLANE_NIC_SITE3=ens1f0             # node NIC on the data-plane VLAN
DATAPLANE_NODE_IP_SITE3=10.20.30.2     # static IP for node's dataplane NIC

# ============================================================================
# Optional: site registration (needed for make deploy-site-agent)
# ============================================================================
SITE_NAME=                       # e.g. "site1" — leave blank to skip registration
SITE_DESCRIPTION=Managed by NICo deploy.env

# Optional: machine-a-tron testing (set to 1 to enable RBAC bypass + test pools)
# MAT=
